# ============================================================================
# OPE Server Environment Configuration
# ============================================================================
# Copy this file to .env and customize values for your deployment.
# The scripts/rebuild.sh script will copy this for you when you first run it.
#
# Variables with <PLACEHOLDER> values are auto-generated or replaced by
# scripts/rebuild.sh during setup. You can override them manually if needed.
# ============================================================================

# ----------------------------------------------------------------------------
# Network Settings
# ----------------------------------------------------------------------------
# Public IP address of the server (auto-generated if blank)
PUBLIC_IP=<IP>

# Set to 1 if server has internet access, 0 for offline/air-gapped deployments (auto-generated if blank, defaults to 0)
IS_ONLINE=<IS_ONLINE>

# ----------------------------------------------------------------------------
# Domain Configuration
# ----------------------------------------------------------------------------
# Admin email address for the system (auto-generated if blank)
ADMIN_EMAIL=admin@<DOMAIN>

# Domain names for each service (auto-generated if blank)
CANVAS_DEFAULT_DOMAIN=<CANVAS_DEFAULT_DOMAIN>
CANVAS_RCE_DEFAULT_DOMAIN=<CANVAS_RCE_DEFAULT_DOMAIN>
CANVAS_MATHMAN_DEFAULT_DOMAIN=<CANVAS_MATHMAN_DEFAULT_DOMAIN>
SMC_DEFAULT_DOMAIN=<SMC_DEFAULT_DOMAIN>

# Additional dnsmasq options for ope-dns (passed directly to dnsmasq command line)
# Example: -A /custom.local/192.168.1.100 -A /printer.local/10.0.0.25
DNS_EXTRAS=<DNS_EXTRAS>

# ----------------------------------------------------------------------------
# Canvas LMS Settings
# ----------------------------------------------------------------------------
# Name displayed in Canvas for the institution
LMS_ACCOUNT_NAME=<LMS_ACCOUNT_NAME>

# Login prompt text shown to users
CANVAS_LOGIN_PROMPT=<CANVAS_LOGIN_PROMPT>

# Timezone for Canvas (e.g., "Pacific Time (US & Canada)")
TIME_ZONE=<TIME_ZONE>

# ----------------------------------------------------------------------------
# Security Secrets (Auto-generated if blank)
# ----------------------------------------------------------------------------
# These secrets are used for encryption and signing. They are auto-generated
# on first run if left as placeholders. DO NOT share these values.
CANVAS_SECRET=<CANVAS_SECRET>
CANVAS_ENC_SECRET=<CANVAS_ENC_SECRET>
CANVAS_SIGN_SECRET=<CANVAS_SIGN_SECRET>

# ----------------------------------------------------------------------------
# Service Passwords
# ----------------------------------------------------------------------------
# Passwords are updated from the SyncApp configuration
IT_PW=<IT_PW>
OFFICE_PW=<OFFICE_PW>

# ----------------------------------------------------------------------------
# SSL/TLS Settings
# ----------------------------------------------------------------------------
# ACME authorization code for Let's Encrypt auto SSL (if using)
ACME_AUTH_CODE=<ACME_AUTH_CODE>

# ----------------------------------------------------------------------------
# NTP Settings
# ----------------------------------------------------------------------------
# NTP servers for time synchronization (comma-separated)
NTP_SERVERS=<NTP_SERVERS>

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Set to ./volumes/smc/src for local SMC development
# (git clone https://github.com/frankyrumple/smc.git into that folder)
SMC_SRC_VOLUME=/dev/null

# ----------------------------------------------------------------------------
# Docker Settings
# ----------------------------------------------------------------------------
# Timeout settings for slow connections (in seconds)
DOCKER_CLIENT_TIMEOUT=180
COMPOSE_HTTP_TIMEOUT=180
