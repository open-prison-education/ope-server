{
  "annotations": { "list": [] },
  "description": "Unified view of host metrics, containers, service uptime, and web traffic.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Host Metrics",
      "type": "link",
      "url": "/d/ope-host-metrics",
      "keepTime": true
    },
    {
      "title": "Container Metrics",
      "type": "link",
      "url": "/d/ope-container-metrics",
      "keepTime": true
    },
    {
      "title": "Service Uptime",
      "type": "link",
      "url": "/d/ope-service-uptime",
      "keepTime": true
    },
    {
      "title": "Traffic by Site",
      "type": "link",
      "url": "/d/ope-traffic-by-site",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Host Metrics",
      "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "CPU Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Usage",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(node_memory_MemTotal_bytes) - sum(node_memory_MemAvailable_bytes)",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "sum(node_memory_MemAvailable_bytes)",
          "legendFormat": "Available",
          "refId": "B"
        },
        {
          "expr": "sum(node_memory_MemTotal_bytes)",
          "legendFormat": "Total",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))",
          "legendFormat": "Used",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }
      },
      "targets": [
        {
          "expr": "count(count by (cpu) (node_cpu_seconds_total{mode=\"idle\"}))",
          "legendFormat": "CPUs",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Disk / (root)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "100 - (sum(node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}) / sum(node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100)",
          "legendFormat": "Used",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Disk /ope (data)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "100 - (sum(node_filesystem_avail_bytes{mountpoint=\"/ope\",fstype!=\"tmpfs\"}) / sum(node_filesystem_size_bytes{mountpoint=\"/ope\",fstype!=\"tmpfs\"}) * 100)",
          "legendFormat": "Used",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Disk I/O",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{device=~\"xvd.*\"}[5m]))",
          "legendFormat": "Read {{device}}",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_disk_written_bytes_total{device=~\"xvd.*\"}[5m]))",
          "legendFormat": "Write {{device}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))",
          "legendFormat": "RX {{device}}",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m]))",
          "legendFormat": "TX {{device}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "System Load",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(node_load1)",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "sum(node_load5)",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "sum(node_load15)",
          "legendFormat": "15m",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "title": "System Uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - max(node_boot_time_seconds)",
          "legendFormat": "Uptime",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Container Metrics",
      "id": 101,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": true,
      "panels": [
        {
          "id": 11,
          "title": "Container CPU Usage",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
          "targets": [
            {
              "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 12,
          "title": "Container Memory Usage",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
          "targets": [
            {
              "expr": "container_memory_usage_bytes{name!=\"\"}",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 13,
          "title": "Container Memory vs Limit",
          "type": "table",
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
          "targets": [
            {
              "expr": "container_memory_usage_bytes{name!=\"\"}",
              "legendFormat": "{{name}}",
              "refId": "A",
              "format": "table",
              "instant": true
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
                "renameByName": { "name": "Container", "Value": "Memory Usage" }
              }
            }
          ]
        },
        {
          "id": 14,
          "title": "Container Network RX",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
          "targets": [
            {
              "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 15,
          "title": "Container Network TX",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
          "targets": [
            {
              "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m]))",
              "legendFormat": "{{name}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 16,
          "title": "Container Restarts (Last Hour)",
          "type": "table",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 66 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "custom": { "align": "auto", "filterable": true }
            },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "name" },
                "properties": [
                  { "id": "displayName", "value": "Container" },
                  { "id": "custom.width", "value": 300 }
                ]
              },
              {
                "matcher": { "id": "byRegexp", "options": "Value.*" },
                "properties": [
                  { "id": "displayName", "value": "Restarts" },
                  {
                    "id": "thresholds",
                    "value": {
                      "mode": "absolute",
                      "steps": [
                        { "color": "green", "value": null },
                        { "color": "yellow", "value": 1 },
                        { "color": "red", "value": 5 }
                      ]
                    }
                  },
                  { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "sortBy": [{ "displayName": "Restarts", "desc": true }],
            "footer": { "show": false }
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
                "renameByName": {}
              }
            }
          ],
          "targets": [
            {
              "expr": "changes(container_start_time_seconds{name!=\"\"}[1h])",
              "legendFormat": "{{name}}",
              "refId": "A",
              "instant": true,
              "format": "table"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "title": "Service Uptime",
      "id": 102,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": true,
      "panels": [
        {
          "id": 17,
          "title": "Service Availability",
          "type": "stat",
          "gridPos": { "h": 6, "w": 24, "x": 0, "y": 33 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "yellow", "value": 0.95 },
                  { "color": "green", "value": 0.99 }
                ]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background" },
          "targets": [
            {
              "expr": "avg_over_time(probe_success[24h])",
              "legendFormat": "{{instance}}",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 18,
          "title": "HTTP Probe Duration",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
          "targets": [
            {
              "expr": "probe_duration_seconds",
              "legendFormat": "{{instance}}",
              "refId": "A"
            }
          ]
        },
        {
          "id": 19,
          "title": "HTTP Status Code",
          "type": "stat",
          "gridPos": { "h": 6, "w": 24, "x": 0, "y": 47 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 200 },
                  { "color": "yellow", "value": 300 },
                  { "color": "red", "value": 400 }
                ]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background" },
          "targets": [
            {
              "expr": "probe_http_status_code",
              "legendFormat": "{{instance}}",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 20,
          "title": "TLS Certificate Expiry",
          "type": "stat",
          "gridPos": { "h": 6, "w": 24, "x": 0, "y": 53 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "yellow", "value": 14 },
                  { "color": "green", "value": 30 }
                ]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background" },
          "targets": [
            {
              "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400",
              "legendFormat": "{{instance}}",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 21,
          "title": "Probe Success History",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 59 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "probe_success",
              "legendFormat": "{{instance}}",
              "refId": "A"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "title": "Web Traffic",
      "id": 103,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": true,
      "panels": [
        {
          "id": 22,
          "type": "stat",
          "title": "Total Requests",
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 34 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [{ "color": "blue", "value": null }]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "none" },
          "targets": [
            {
              "expr": "sum(increase(nginx_requests_total{host=~\"$host\"}[$__range]))",
              "legendFormat": "",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 23,
          "type": "stat",
          "title": "Page Views",
          "gridPos": { "h": 4, "w": 6, "x": 6, "y": 34 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [{ "color": "green", "value": null }]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "none" },
          "targets": [
            {
              "expr": "sum(increase(nginx_pageviews_total{host=~\"$host\"}[$__range]))",
              "legendFormat": "",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 24,
          "type": "stat",
          "title": "Error Rate",
          "gridPos": { "h": 4, "w": 6, "x": 12, "y": 34 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "decimals": 2,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.01 },
                  { "color": "red", "value": 0.05 }
                ]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "none" },
          "targets": [
            {
              "expr": "sum(rate(nginx_requests_total{host=~\"$host\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(nginx_requests_total{host=~\"$host\"}[$__rate_interval])), 1e-10)",
              "legendFormat": "",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 25,
          "type": "stat",
          "title": "Active Sites",
          "gridPos": { "h": 4, "w": 6, "x": 18, "y": 34 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [{ "color": "purple", "value": null }]
              }
            },
            "overrides": []
          },
          "options": { "colorMode": "background", "graphMode": "none" },
          "targets": [
            {
              "expr": "count(count by (host) (nginx_requests_total{host=~\"$host\"}))",
              "legendFormat": "",
              "refId": "A",
              "instant": true
            }
          ]
        },
        {
          "id": 26,
          "type": "timeseries",
          "title": "Requests / sec by Site",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
          "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 20,
                "pointSize": 5,
                "showPoints": "never",
                "spanNulls": true,
