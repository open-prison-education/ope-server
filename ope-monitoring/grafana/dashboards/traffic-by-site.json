{
  "annotations": {
    "list": []
  },
  "description": "Web analytics for first-party visitor hosts (canvas, smc, penpot, monitoring, cea, dl, websites). Excludes Canvas helper vhosts (rce/mathman), monitoring probes from site counters, and collapses junk Host headers to other. Page views are estimated (GET HTML 2xx/304, known bots excluded) — not unique humans.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "description": "Canonical-host requests in the selected range, excluding monitoring probes.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Page Views",
      "description": "Estimated page views: canonical-host GET responses with text/html and 2xx/304, excluding monitoring probes and known bot/spider user agents. Not unique visitors.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(nginx_site_pageviews_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "description": "5xx share of canonical-host requests over the selected range (probes excluded). Shows 0% when there are requests but no 5xx.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "0%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "(sum(increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\", status=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range])) or vector(0), 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Sites",
      "description": "Canonical hosts (canvas, smc, penpot, monitoring, cea, dl, websites) with at least one site request in the selected time range. Probes excluded. Changes with the time picker and Site filter — not a fixed inventory count (see Service Uptime for monitored targets).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "count(count by (host) (increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range]) > 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic Over Time",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests / min by Site",
      "description": "All-request rate per minute by canonical subdomain (probes excluded). Includes HTML, assets, APIs, and scanners — the primary load signal for server admins. HTML-only totals are in the Page Views overview stat.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "req/min",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (host) (rate(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__rate_interval])) * 60",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Content Analysis",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top Sites by Requests",
      "description": "Request totals for first-party visitor hosts only (canvas, smc, penpot, monitoring, cea, dl, websites). Uses nginx_site_requests_total (probes and non-canonical Host headers already excluded at scrape time). Zeros omitted.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Site"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host": "Site",
              "Value": "Requests",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (host) (increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range])) > 0)",
          "legendFormat": "{{host}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top External Referrer Domains",
      "description": "External Referer domains for traffic to first-party visitor hosts. Excludes empty/dash referrers, IP referrers, monitoring probe UAs, and first-party domains (*.corrections.sbctc.edu, *.correctionsed.com).",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "ope-loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Referrer Domain"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 450
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "referer_domain": "Referrer Domain",
              "Value": "Requests",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (referer_domain) (count_over_time({job=\"nginx\", host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"} | user_agent !~ `(?i).*(blackbox|prometheus|grafana|alloy|healthcheck|kube-probe|bot|spider|crawler|slurp|bingpreview|facebookexternalhit|bytespider|claudebot|gptbot|chatgpt|anthropic|applebot|semrush|ahrefs|mj12bot|dotbot|petalbot|yandex|baidu|duckduck|scrapy|headless).*` | referer != `` | referer != `-` | referer !~ `.*corrections[.]sbctc[.]edu.*` | referer !~ `.*correctionsed[.]com.*` | referer !~ `https?://([0-9]{1,3}[.]){3}[0-9]{1,3}` | line_format `{{.referer}}` | regexp `(?i)https?://(?P<referer_domain>[^/:]+)` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Client Analysis",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 12,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "HTTP Status Codes",
      "description": "Status distribution for canonical-host requests (probes excluded). Zero-count statuses omitted. Status code is the row label; Requests shows count with a bar.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "status": "Status",
              "Value": "Requests",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(15, sum by (status) (increase(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"}[$__range])) > 0)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top User Agents (non-bot)",
      "description": "Most common user agents on selected hosts after excluding monitoring probes and known crawlers/bots. Remaining rows can still include scanners that forge browser UAs — nginx cannot identify humans with certainty.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "ope-loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "User Agent"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 500
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user_agent": "User Agent",
              "Value": "Requests",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(15, sum by (user_agent) (count_over_time({job=\"nginx\", host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"} | user_agent != `` | user_agent !~ `(?i).*(blackbox|prometheus|grafana|alloy|healthcheck|kube-probe|bot|spider|crawler|slurp|bingpreview|facebookexternalhit|bytespider|claudebot|gptbot|chatgpt|anthropic|applebot|semrush|ahrefs|mj12bot|dotbot|petalbot|yandex|baidu|duckduck|scrapy|headless).*` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Hourly Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 15,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Hourly Traffic Pattern (req/min)",
      "description": "Request rate per minute at 1-hour granularity for canonical hosts (probes excluded).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "ope-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "req/min",
          "displayName": "${__field.labels.host}",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            },
            "barAlignment": 0
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        }
      },
      "interval": "1h",
      "targets": [
        {
          "expr": "sum by (host) (rate(nginx_site_requests_total{host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\", host!=\"\"}[$__rate_interval])) * 60",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Geographic Breakdown",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "id": 17,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Requests by Country",
      "description": "GeoIP country for canonical-host requests (probes excluded). GeoLite2 maps hosting/VPN ranges to countries \u2014 high non-US shares often indicate scanners, not end users.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "id": 18,
      "datasource": {
        "type": "loki",
        "uid": "ope-loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Country"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "geoip_country_name": "Country",
              "Value": "Requests",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(30, sum by (geoip_country_name) (count_over_time({job=\"nginx\", host=~\"$host\", host=~\"^(canvas|smc|penpot|monitoring|cea|dl|websites)\\\\..+\"} | user_agent !~ `(?i).*(blackbox|prometheus|grafana|alloy|healthcheck|kube-probe|bot|spider|crawler|slurp|bingpreview|facebookexternalhit|bytespider|claudebot|gptbot|chatgpt|anthropic|applebot|semrush|ahrefs|mj12bot|dotbot|petalbot|yandex|baidu|duckduck|scrapy|headless).*` | geoip_country_name != `` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "ope",
    "nginx",
    "analytics",
    "traffic"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ope-prometheus"
        },
        "definition": "label_values(nginx_site_requests_total, host)",
        "query": {
          "query": "label_values(nginx_site_requests_total, host)",
          "refId": "StandardVariableQuery"
        },
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Traffic by Site",
  "uid": "ope-traffic-by-site",
  "version": 8
}
