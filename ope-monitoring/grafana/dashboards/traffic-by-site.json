{
  "annotations": { "list": [] },
  "description": "Web analytics from nginx gateway logs: per-subdomain traffic, top sites, referrers, user agents, and geographic breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(increase(nginx_requests_total{host=~\"$host\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Page Views",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(increase(nginx_pageviews_total{host=~\"$host\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(rate(nginx_requests_total{host=~\"$host\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(nginx_requests_total{host=~\"$host\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Sites",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "count(count by (host) (nginx_requests_total{host=~\"$host\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests / sec by Site",
      "description": "Rate of all HTTP requests broken down by subdomain.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum by (host) (rate(nginx_requests_total{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Page Views / sec by Site",
      "description": "Rate of HTML page views (text/html responses) by subdomain.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "sum by (host) (rate(nginx_pageviews_total{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Content Analysis",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 9,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top Sites by Requests",
      "description": "Total requests per site (subdomain) in the selected time range.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Site" },
            "properties": [
              { "id": "custom.width", "value": 400 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "host": "Site",
              "Value": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (host) (increase(nginx_requests_total{host=~\"$host\"}[$__range])))",
          "legendFormat": "{{host}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Referrer Domains",
      "description": "External domains driving traffic to the site, aggregated by domain.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 11,
      "datasource": { "type": "loki", "uid": "ope-loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Referrer Domain" },
            "properties": [
              { "id": "custom.width", "value": 450 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "referer_domain": "Referrer Domain",
              "Value": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (referer_domain) (count_over_time({job=\"nginx\", host=~\"$host\"} | json | referer != `` | referer != `-` | referer !~ `https?://\\d+\\.\\d+\\.\\d+\\.\\d+` | line_format `{{.referer}}` | regexp `https?://(?P<referer_domain>[^/]+)` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Client Analysis",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 12,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "piechart",
      "title": "HTTP Status Codes",
      "description": "Distribution of HTTP response status codes.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(nginx_requests_total{host=~\"$host\"}[$__range]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Top User Agents (Real Users)",
      "description": "Most common user agent strings from real visitors. Internal monitoring agents (Blackbox Exporter, Prometheus, etc.) are excluded.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 14,
      "datasource": { "type": "loki", "uid": "ope-loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "User Agent" },
            "properties": [
              { "id": "custom.width", "value": 500 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "user_agent": "User Agent",
              "Value": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(15, sum by (user_agent) (count_over_time({job=\"nginx\", host=~\"$host\"} | json | user_agent != `` | user_agent !~ `(?i)(blackbox.exporter|prometheus|grafana|alloy|healthcheck|kube-probe)` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Hourly Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 15,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Hourly Traffic Pattern (req/min)",
      "description": "Request rate per minute at 1-hour granularity, showing daily usage patterns.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 },
      "id": 16,
      "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "${__field.labels.host}",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "mode": "normal" },
            "barAlignment": 0
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "sum"]
        }
      },
      "interval": "1h",
      "targets": [
        {
          "expr": "sum by (host) (rate(nginx_requests_total{host=~\"$host\", host!=\"\"}[$__rate_interval])) * 60",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Geographic Breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
      "id": 17,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Requests by Country",
      "description": "Geographic distribution of requests over the selected time range.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "id": 18,
      "datasource": { "type": "loki", "uid": "ope-loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Country" },
            "properties": [
              { "id": "custom.width", "value": 300 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "geoip_country_name": "Country",
              "Value": "Requests"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(30, sum by (geoip_country_name) (count_over_time({job=\"nginx\", host=~\"$host\"} | json | geoip_country_name != `` | __error__=`` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["ope", "nginx", "analytics", "traffic"],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Site",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "ope-prometheus" },
        "query": { "query": "label_values(nginx_requests_total, host)" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Traffic by Site",
  "uid": "ope-traffic-by-site",
  "version": 1
}
