// =============================================================================
// Prometheus remote-write destination
// Requires --web.enable-remote-write-receiver on the Prometheus container.
// =============================================================================
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
  external_labels = {
    facility      = "<FACILITY_ID>",
    facility_name = "<FACILITY_NAME>",
  }
}

// #IF <CENTRAL_METRICS_URL>
// =============================================================================
// Central Prometheus remote-write — pushes all metrics to the central instance.
// Activated by setting central_metrics_url in config.yml.
// =============================================================================
prometheus.remote_write "central" {
  endpoint {
    url = "<CENTRAL_METRICS_URL>"
  }
  external_labels = {
    facility      = "<FACILITY_ID>",
    facility_name = "<FACILITY_NAME>",
  }
}

// #ENDIF <CENTRAL_METRICS_URL>
// =============================================================================
// Loki write destination
// tenant_id is inert while Loki runs with auth_enabled: false (everything lands
// in the "fake" tenant). It is set now so Phase 4 centralization needs no
// pipeline change.
// =============================================================================
loki.write "default" {
  endpoint {
    url       = "http://loki:3100/loki/api/v1/push"
    tenant_id = "<FACILITY_ID>"
  }
  external_labels = {
    facility = "<FACILITY_ID>",
  }
}

// #IF <CENTRAL_LOKI_URL>
// =============================================================================
// Central Loki write — pushes logs to the central aggregation instance.
// Uses X-Scope-OrgID (tenant_id) so the central Loki can partition by facility.
// Activated by setting central_loki_url in config.yml.
// =============================================================================
loki.write "central" {
  endpoint {
    url       = "<CENTRAL_LOKI_URL>"
    tenant_id = "<FACILITY_ID>"
  }
  external_labels = {
    facility      = "<FACILITY_ID>",
    facility_name = "<FACILITY_NAME>",
  }
}

// #ENDIF <CENTRAL_LOKI_URL>

// =============================================================================
// Host metrics via built-in node_exporter
// =============================================================================
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  disable_collectors = [
    "arp", "bonding", "infiniband", "ipvs",
    "nfs", "nfsd", "tapestats", "wifi", "zfs",
  ]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
// #IF <CENTRAL_METRICS_URL>
  forward_to      = [prometheus.remote_write.default.receiver, prometheus.remote_write.central.receiver]
// #ELSE
  forward_to      = [prometheus.remote_write.default.receiver]
// #ENDIF <CENTRAL_METRICS_URL>
  scrape_interval = "30s"
}

// =============================================================================
// Container metrics via built-in cAdvisor
// =============================================================================
prometheus.exporter.cadvisor "containers" {
  docker_host            = "unix:///var/run/docker.sock"
  docker_only            = true
  store_container_labels = true
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
// #IF <CENTRAL_METRICS_URL>
  forward_to      = [prometheus.remote_write.default.receiver, prometheus.remote_write.central.receiver]
// #ELSE
  forward_to      = [prometheus.remote_write.default.receiver]
// #ENDIF <CENTRAL_METRICS_URL>
  scrape_interval = "30s"
}

// =============================================================================
// HTTP probes for each first-party virtual host (same allowlist as is_site).
// Alloy sets job=integrations/blackbox/<name>. discovery.relabel below sets
// instance to the probed URL so dashboards/alerts can name each service.
// =============================================================================
prometheus.exporter.blackbox "vhosts" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 10s, http: { fail_if_not_ssl: true, preferred_ip_protocol: ip4, valid_status_codes: [], tls_config: { insecure_skip_verify: false } } } } }"

  target {
    name    = "canvas"
    address = "https://canvas.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "smc"
    address = "https://smc.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "penpot"
    address = "https://penpot.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "monitoring"
    address = "https://monitoring.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "cea"
    address = "https://cea.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "dl"
    address = "https://dl.<DOMAIN>"
    module  = "http_2xx"
  }

  target {
    name    = "websites"
    address = "https://websites.<DOMAIN>"
    module  = "http_2xx"
  }
}

discovery.relabel "vhosts" {
  targets = prometheus.exporter.blackbox.vhosts.targets

  rule {
    source_labels = ["__param_target"]
    target_label  = "instance"
  }
}

prometheus.scrape "vhosts" {
  targets         = discovery.relabel.vhosts.output
// #IF <CENTRAL_METRICS_URL>
  forward_to      = [prometheus.remote_write.default.receiver, prometheus.remote_write.central.receiver]
// #ELSE
  forward_to      = [prometheus.remote_write.default.receiver]
// #ENDIF <CENTRAL_METRICS_URL>
  scrape_interval = "60s"
}

// =============================================================================
// Nginx access log pipeline — web analytics from gateway JSON logs
//
// Tails /var/log/nginx/access.json.log (the vhost_json format emitted by
// ope-gateway). Extracts fields, sets low-cardinality Loki labels, stores
// high-cardinality data as structured metadata, and emits Prometheus counters
// for year-scale trend queries that survive Loki's 30-day retention.
//
// GeoIP: stage.geoip requires GeoLite2-City.mmdb at the path below.
// Phase 3 bundles the DB for air-gapped distribution; for online deployments
// download it from MaxMind (free account required) and place it in
// <volumes_root>/monitoring/geoip/. Without the DB, alloy-entrypoint.sh strips
// stage.geoip so traffic metrics/logs still flow (geo panels stay empty).
// =============================================================================

local.file_match "nginx_logs" {
  path_targets = [{
    __path__ = "/var/log/nginx/access.json.log",
    job      = "nginx",
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx_logs.targets
  forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
  stage.json {
    expressions = {
      time           = "time",
      host           = "host",
      remote_addr    = "remote_addr",
      xff            = "xff",
      method         = "method",
      uri            = "uri",
      request_uri    = "request_uri",
      status         = "status",
      bytes          = "bytes",
      request_length = "request_length",
      request_time   = "request_time",
      upstream_time  = "upstream_time",
      referer        = "referer",
      user_agent     = "user_agent",
      scheme         = "scheme",
      ssl_protocol   = "ssl_protocol",
      content_type   = "content_type",
    }
  }

  stage.timestamp {
    source = "time"
    format = "2006-01-02T15:04:05-07:00"
  }

  stage.geoip {
    source  = "remote_addr"
    db      = "/etc/alloy/geoip/GeoLite2-City.mmdb"
    db_type = "city"
  }

  // Preserve the raw Host header, then collapse non-canonical values so Loki
  // stream labels and Prometheus counter labels stay bounded (~7 sites + other).
  stage.template {
    source   = "host_raw"
    template = "{{ .host }}"
  }

  stage.template {
    source = "host"
    template = "{{ if or (eq .host_raw \"canvas.<DOMAIN>\") (eq .host_raw \"smc.<DOMAIN>\") (eq .host_raw \"penpot.<DOMAIN>\") (eq .host_raw \"monitoring.<DOMAIN>\") (eq .host_raw \"cea.<DOMAIN>\") (eq .host_raw \"dl.<DOMAIN>\") (eq .host_raw \"websites.<DOMAIN>\") }}{{ .host_raw }}{{ else }}other{{ end }}"
  }

  // Low-cardinality labels only: allowlisted host (+ other), method, status.
  stage.labels {
    values = {
      host   = "host",
      status = "status",
      method = "method",
    }
  }

  // High-cardinality fields as structured metadata — queryable in Loki 3.x
  // without contributing to stream cardinality. host_raw keeps scanner Hosts.
  stage.structured_metadata {
    values = {
      host_raw               = "host_raw",
      uri                    = "uri",
      request_uri            = "request_uri",
      remote_addr            = "remote_addr",
      xff                    = "xff",
      referer                = "referer",
      user_agent             = "user_agent",
      bytes                  = "bytes",
      request_time           = "request_time",
      upstream_time          = "upstream_time",
      scheme                 = "scheme",
      ssl_protocol           = "ssl_protocol",
      content_type           = "content_type",
      geoip_country_name     = "",
      geoip_country_code     = "",
      geoip_city_name        = "",
      geoip_continent_code   = "",
      geoip_subdivision_name = "",
    }
  }

  // HTML response flag (case-insensitive content_type prefix).
  stage.template {
    source   = "is_page"
    template = "{{ if .content_type }}{{ if ne (TrimPrefix (ToLower .content_type) \"text/html\") (ToLower .content_type) }}1{{ end }}{{ end }}"
  }

  // Canonical-host load signal: first-party hosts only, monitoring probes out.
  // Intentionally keeps crawlers/scanners — use nginx_site_pageviews for pages.
  stage.template {
    source = "is_site"
    template = "{{ if and (or (eq .host_raw \"canvas.<DOMAIN>\") (eq .host_raw \"smc.<DOMAIN>\") (eq .host_raw \"penpot.<DOMAIN>\") (eq .host_raw \"monitoring.<DOMAIN>\") (eq .host_raw \"cea.<DOMAIN>\") (eq .host_raw \"dl.<DOMAIN>\") (eq .host_raw \"websites.<DOMAIN>\")) (eq (regexReplaceAll \"(?i)(blackbox.?exporter|prometheus/|kube-probe|healthcheck|grafana/|alloy/)\" .user_agent \"\") .user_agent) }}1{{ end }}"
  }

  // Estimated page view: canonical host, GET, 2xx/304, HTML, not probe/bot UA.
  // Not unique visitors — nginx cannot identify humans with certainty.
  stage.template {
    source = "is_site_page"
    template = "{{ if and (eq .is_site \"1\") (eq .is_page \"1\") (eq .method \"GET\") (or (eq .status \"200\") (eq .status \"201\") (eq .status \"204\") (eq .status \"301\") (eq .status \"302\") (eq .status \"304\")) (eq (regexReplaceAll \"(?i)(bot|spider|crawler|slurp|bingpreview|facebookexternalhit|bytespider|claudebot|gptbot|chatgpt|anthropic|applebot|semrush|ahrefs|mj12bot|dotbot|petalbot|yandex|baidu|duckduck|scrapy|headless)\" .user_agent \"\") .user_agent) }}1{{ end }}"
  }

  // Raw gateway volume by allowlisted host label (junk Hosts collapse to other).
  // Probes still count here until the drop stage; Traffic by Site uses nginx_site_*.
  stage.metrics {
    metric.counter {
      name              = "nginx_requests_total"
      description       = "Total nginx requests by host, method, and status"
      prefix            = ""
      action            = "inc"
      match_all         = true
      max_idle_duration = "24h"
    }
  }

  stage.metrics {
    metric.counter {
      name              = "nginx_pageviews_total"
      description       = "HTML responses (text/html) before site/bot filters"
      prefix            = ""
      source            = "is_page"
      action            = "inc"
      max_idle_duration = "24h"
    }
  }

  // Increment only when is_site == "1" (canonical host, non-probe UA).
  stage.metrics {
    metric.counter {
      name              = "nginx_site_requests_total"
      description       = "Canonical-host nginx requests excluding monitoring probes"
      prefix            = ""
      source            = "is_site"
      value             = "1"
      action            = "inc"
      max_idle_duration = "24h"
    }
  }

  stage.metrics {
    metric.counter {
      name              = "nginx_site_pageviews_total"
      description       = "Estimated page views: canonical GET HTML 2xx/304, probes and known bots excluded"
      prefix            = ""
      source            = "is_site_page"
      value             = "1"
      action            = "inc"
      max_idle_duration = "24h"
    }
  }

  // Blackbox checks are already in Prometheus probe_* metrics. Drop them from
  // Loki so dashboards are not half probe noise. Metrics above still saw them.
  stage.drop {
    source             = "user_agent"
    expression         = "(?i)^Blackbox Exporter/"
    drop_counter_reason = "blackbox_probe"
  }

// #IF <CENTRAL_LOKI_URL>
  forward_to = [loki.write.default.receiver, loki.write.central.receiver]
// #ELSE
  forward_to = [loki.write.default.receiver]
// #ENDIF <CENTRAL_LOKI_URL>
}
